.processing-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 10, 12, 0.82);
    color: rgb(226, 216, 190);
}

.processing-frame {
    width: 1160px;
    height: 720px;
    padding: 20px;
    background-color: rgb(29, 27, 24);
    background-image: url("project://database/Assets/ThirdParty/Kenney/FantasyUIBorders/PNG/Default/Panel/panel-000.png");
    -unity-slice-left: 16;
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-background-image-tint-color: rgb(139, 110, 70);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(139, 110, 70);
    border-right-color: rgb(139, 110, 70);
    border-top-color: rgb(174, 143, 91);
    border-bottom-color: rgb(91, 69, 43);
}

.processing-header {
    height: 68px;
    padding-left: 18px;
    padding-right: 14px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(37, 33, 27);
    border-bottom-width: 1px;
    border-bottom-color: rgb(124, 102, 68);
}

.processing-title {
    flex-grow: 1;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(241, 223, 176);
}

.processing-gold {
    margin-right: 18px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(222, 178, 88);
}

.processing-close,
.processing-craft,
.processing-confirm-button {
    min-width: 130px;
    height: 40px;
    color: rgb(224, 211, 180);
    background-color: rgb(52, 47, 39);
    border-left-color: rgb(122, 96, 60);
    border-right-color: rgb(122, 96, 60);
    border-top-color: rgb(122, 96, 60);
    border-bottom-color: rgb(122, 96, 60);
}

.processing-body {
    margin-top: 18px;
    flex-grow: 1;
    flex-direction: row;
}

.processing-series-panel,
.processing-recipes-panel,
.processing-details-panel {
    padding: 16px;
    background-color: rgb(35, 33, 29);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(93, 75, 49);
    border-right-color: rgb(93, 75, 49);
    border-top-color: rgb(112, 89, 55);
    border-bottom-color: rgb(67, 54, 38);
}

.processing-series-panel { width: 260px; }
.processing-recipes-panel { width: 340px; margin-left: 14px; }
.processing-details-panel { flex-grow: 1; margin-left: 14px; }

.processing-heading,
.processing-detail-title {
    margin-bottom: 12px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 221, 176);
}

.processing-series-scroll { flex-grow: 1; }

.processing-series-button,
.processing-recipe-button {
    min-height: 46px;
    margin-bottom: 8px;
    padding-left: 14px;
    white-space: normal;
    -unity-text-align: middle-left;
    color: rgb(218, 205, 177);
    background-color: rgb(50, 49, 45);
    border-left-color: rgb(91, 78, 58);
    border-right-color: rgb(91, 78, 58);
    border-top-color: rgb(91, 78, 58);
    border-bottom-color: rgb(91, 78, 58);
}

.processing-recipe-button { min-height: 92px; font-size: 16px; }

.processing-selected,
.processing-selected:hover,
.processing-selected:focus {
    color: rgb(255, 236, 187);
    background-color: rgb(88, 69, 43);
    border-left-color: rgb(219, 175, 99);
    border-right-color: rgb(219, 175, 99);
    border-top-color: rgb(219, 175, 99);
    border-bottom-color: rgb(219, 175, 99);
}

.processing-unavailable { opacity: 0.55; }

.processing-detail-title { font-size: 24px; }
.processing-detail-stats { margin-bottom: 18px; color: rgb(195, 177, 139); }
.processing-subheading { margin-top: 14px; margin-bottom: 6px; -unity-font-style: bold; color: rgb(223, 194, 137); }
.processing-detail-copy { white-space: normal; font-size: 15px; color: rgb(220, 209, 184); }
.processing-costs { line-height: 22px; }
.processing-spacer { flex-grow: 1; }
.processing-craft { min-width: 210px; align-self: flex-end; }

.processing-message {
    min-height: 30px;
    margin-top: 10px;
    color: rgb(186, 169, 133);
}

.processing-footer {
    height: 24px;
    -unity-text-align: middle-right;
    font-size: 11px;
    color: rgb(139, 130, 112);
}

.processing-confirm-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(7, 7, 6, 0.80);
}

.processing-confirm-dialog {
    width: 560px;
    padding: 24px;
    background-color: rgb(34, 31, 27);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(139, 110, 70);
    border-right-color: rgb(139, 110, 70);
    border-top-color: rgb(184, 148, 88);
    border-bottom-color: rgb(91, 69, 43);
}

.processing-confirm-title { font-size: 22px; -unity-font-style: bold; color: rgb(241, 223, 176); }
.processing-confirm-copy { margin-top: 14px; margin-bottom: 20px; white-space: normal; color: rgb(218, 204, 173); }
.processing-confirm-actions { flex-direction: row; justify-content: flex-end; }
.processing-confirm-button { margin-left: 10px; }
