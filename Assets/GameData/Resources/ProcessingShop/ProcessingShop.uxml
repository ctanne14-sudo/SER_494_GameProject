<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="ProcessingShop.uss" />
    <ui:VisualElement name="processingShopOverlay" class="processing-overlay">
        <ui:VisualElement class="processing-frame">
            <ui:VisualElement class="processing-header">
                <ui:Label text="Processing Shop" class="processing-title" />
                <ui:Label name="goldLabel" text="Gold  0" class="processing-gold" />
                <ui:Button name="closeButton" text="Close" class="processing-close" />
            </ui:VisualElement>
            <ui:VisualElement class="processing-body">
                <ui:VisualElement class="processing-series-panel">
                    <ui:Label text="Armor Series" class="processing-heading" />
                    <ui:ScrollView name="seriesScroll" class="processing-series-scroll">
                        <ui:VisualElement name="seriesContainer" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement class="processing-recipes-panel">
                    <ui:Label text="Armor Pieces" class="processing-heading" />
                    <ui:VisualElement name="recipeContainer" class="processing-recipe-container" />
                </ui:VisualElement>
                <ui:VisualElement class="processing-details-panel">
                    <ui:Label name="recipeName" text="Select Armor" class="processing-detail-title" />
                    <ui:Label name="recipeStats" class="processing-detail-stats" />
                    <ui:Label text="Effect" class="processing-subheading" />
                    <ui:Label name="recipeEffect" class="processing-detail-copy" />
                    <ui:Label text="Required" class="processing-subheading" />
                    <ui:Label name="recipeCosts" class="processing-detail-copy processing-costs" />
                    <ui:VisualElement class="processing-spacer" />
                    <ui:Button name="craftButton" text="Process Armor" class="processing-craft" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="processingMessage" class="processing-message" />
            <ui:Label text="WASD / Arrows / D-pad: Navigate     F / Enter / A: Confirm     Esc / B / Right Click: Close" class="processing-footer" />
        </ui:VisualElement>
        <ui:VisualElement name="craftConfirmOverlay" class="processing-confirm-overlay">
            <ui:VisualElement class="processing-confirm-dialog">
                <ui:Label text="Confirm Processing" class="processing-confirm-title" />
                <ui:Label name="craftConfirmPrompt" class="processing-confirm-copy" />
                <ui:VisualElement class="processing-confirm-actions">
                    <ui:Button name="confirmCraftButton" text="Process" class="processing-confirm-button" />
                    <ui:Button name="cancelCraftButton" text="Back" class="processing-confirm-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
