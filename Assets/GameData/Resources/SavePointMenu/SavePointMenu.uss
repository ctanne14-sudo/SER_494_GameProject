.save-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 10, 12, 0.82);
    color: rgb(226, 216, 190);
}

.save-frame {
    width: 760px;
    min-height: 530px;
    padding: 22px;
    background-color: rgb(29, 27, 24);
    background-image: url("project://database/Assets/ThirdParty/Kenney/FantasyUIBorders/PNG/Default/Panel/panel-000.png");
    -unity-slice-left: 16;
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-background-image-tint-color: rgb(139, 110, 70);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(139, 110, 70);
    border-right-color: rgb(139, 110, 70);
    border-top-color: rgb(174, 143, 91);
    border-bottom-color: rgb(91, 69, 43);
}

.save-header {
    height: 72px;
    padding-left: 18px;
    padding-right: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(37, 33, 27);
    border-bottom-width: 1px;
    border-bottom-color: rgb(124, 102, 68);
}

.save-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(241, 223, 176);
}

.save-kicker {
    font-size: 12px;
    letter-spacing: 2px;
    color: rgb(164, 145, 112);
}

.save-heading {
    margin-top: 22px;
    margin-left: 14px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(236, 218, 174);
}

.save-message {
    min-height: 30px;
    margin: 8px 14px 12px 14px;
    color: rgb(174, 158, 128);
    white-space: normal;
}

.save-slots {
    margin-left: 14px;
    margin-right: 14px;
    flex-grow: 1;
}

.save-slot {
    height: 78px;
    margin-bottom: 12px;
    padding-left: 20px;
    white-space: normal;
    -unity-text-align: middle-left;
    font-size: 16px;
    color: rgb(221, 209, 179);
    background-color: rgb(50, 50, 47);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(94, 82, 62);
    border-right-color: rgb(94, 82, 62);
    border-top-color: rgb(111, 95, 69);
    border-bottom-color: rgb(69, 59, 46);
}

.save-slot:hover,
.save-slot:focus {
    background-color: rgb(65, 58, 47);
    color: rgb(255, 235, 184);
    border-left-color: rgb(170, 136, 82);
    border-right-color: rgb(170, 136, 82);
    border-top-color: rgb(170, 136, 82);
    border-bottom-color: rgb(170, 136, 82);
}

.save-slot-selected,
.save-slot-selected:hover,
.save-slot-selected:focus {
    background-color: rgb(89, 71, 45);
    color: rgb(255, 235, 184);
    border-left-color: rgb(219, 175, 99);
    border-right-color: rgb(219, 175, 99);
    border-top-color: rgb(219, 175, 99);
    border-bottom-color: rgb(219, 175, 99);
}

.save-footer {
    height: 28px;
    margin-right: 14px;
    -unity-text-align: middle-right;
    font-size: 12px;
    color: rgb(143, 134, 116);
}

.save-confirm-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(7, 7, 6, 0.78);
}

.save-confirm-dialog {
    width: 570px;
    padding: 24px;
    background-color: rgb(34, 31, 27);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(139, 110, 70);
    border-right-color: rgb(139, 110, 70);
    border-top-color: rgb(184, 148, 88);
    border-bottom-color: rgb(91, 69, 43);
}

.save-confirm-heading {
    margin-bottom: 12px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(241, 223, 176);
}

.save-confirm-prompt {
    margin-bottom: 20px;
    color: rgb(218, 204, 173);
    white-space: normal;
}

.save-confirm-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.save-confirm-button {
    min-width: 150px;
    min-height: 42px;
    margin-left: 10px;
    color: rgb(222, 207, 175);
    background-color: rgb(52, 47, 39);
    border-left-color: rgb(122, 96, 60);
    border-right-color: rgb(122, 96, 60);
    border-top-color: rgb(122, 96, 60);
    border-bottom-color: rgb(122, 96, 60);
}

.save-confirm-button:hover,
.save-confirm-button:focus,
.save-confirm-selected {
    color: rgb(255, 235, 184);
    background-color: rgb(89, 71, 45);
    border-left-color: rgb(219, 175, 99);
    border-right-color: rgb(219, 175, 99);
    border-top-color: rgb(219, 175, 99);
    border-bottom-color: rgb(219, 175, 99);
}

.save-danger-button {
    color: rgb(222, 142, 126);
}
