stateDiagram-v2
    [*] --> EncounterSetup
    EncounterSetup --> CameraTransitionIn
    CameraTransitionIn --> BuildTurnOrder
    BuildTurnOrder --> StartTurn
    StartTurn --> ApplyStartEffects
    ApplyStartEffects --> OptionalWeaponSwitch
    OptionalWeaponSwitch --> SelectAction
    SelectAction --> SelectTargets
    SelectTargets --> PreviewConsequences
    PreviewConsequences --> SelectAction: Cancel or invalid
    PreviewConsequences --> ResolveAction: Confirm
    ResolveAction --> ResolveEnvironmentQueue
    ResolveEnvironmentQueue --> ApplyEndEffects
    ApplyEndEffects --> CheckOutcome
    CheckOutcome --> StartTurn: Battle continues
    CheckOutcome --> Victory: All enemies defeated
    CheckOutcome --> Defeat: Party defeated
    Victory --> RewardsAndInherentSkillLearning
    RewardsAndInherentSkillLearning --> CameraTransitionOut
    CameraTransitionOut --> [*]
    Defeat --> EncounterSetup: Retry snapshot
    Defeat --> [*]: Abandon run
